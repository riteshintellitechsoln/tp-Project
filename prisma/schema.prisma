generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBooks Book[]    @relation("BookCreatedByAdmin")

  @@map("admins")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  downloads     Download[]
  leads         Lead[]
  sessions      Session[]


firstName                   String?
  lastName                    String?
  phone                       String?
  companyName                 String?
  jobTitle                    String?
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?

  companyWebsite               String?

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  icon        String?
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  books       BookCategory[]

  @@index([isActive, order])
  @@map("categories")
}

/// Publisher/vendor behind a book — managed via Admin > Companies CRUD.
/// NOT the same thing as a lead's employer (see Lead.companyName below).
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  logoUrl   String?
  website   String?
  about     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]

  @@map("companies")
}

model Book {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  description      String
  shortDescription String?
  coverImageUrl    String
  pdfFileKey       String
  fileSizeBytes    Int?
  pages            Int?
  language         String         @default("English")
  format           BookFormat     @default(EBOOK)
  tags             String[]       @default([])
  status           BookStatus     @default(DRAFT)
  isFeatured       Boolean        @default(false)
  isTrending       Boolean        @default(false)
  publishedAt      DateTime?
  viewCount        Int            @default(0)
  downloadCount    Int            @default(0)
  companyId        String
  createdByAdminId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  downloadLimit    Int?
  forceOutOfStock  Boolean        @default(false)
  categories       BookCategory[]
  company          Company        @relation(fields: [companyId], references: [id])
  createdByAdmin   Admin?         @relation("BookCreatedByAdmin", fields: [createdByAdminId], references: [id])
  downloads        Download[]

  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([companyId])
  @@map("books")
}

/// Explicit join table (rather than an implicit Prisma m-n) so a book's
/// category placement can later carry its own metadata if needed
/// (e.g. per-category featured ordering) without a schema migration.
model BookCategory {
  id         String   @id @default(cuid())
  bookId     String
  categoryId String
  createdAt  DateTime @default(now())
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([bookId, categoryId])
  @@index([categoryId])
  @@map("book_categories")
}

/// One row per unique person (deduped by company email). This is the
/// sales-facing contact record shown in Admin > Leads.
model Lead {
  id            String      @id @default(cuid())
  fullName      String
  email         String      @unique
  phone         String
  jobTitle      String
  companyName   String
  companyDomain String?
  country       String
  state         String?
  city          String?
  department    String
  industry      String
  companySize   CompanySize
  consentGiven  Boolean     @default(false)
  consentAt     DateTime?
  ipAddress     String?
  userAgent     String?
  userId        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  downloads     Download[]
  user          User?       @relation(fields: [userId], references: [id])

  companyWebsite String?
  
  @@index([companyDomain])
  @@index([industry])
  @@index([createdAt])
  @@map("leads")
}

/// One row per download EVENT. Ties a Lead to a Book at a point in time,
/// and carries the secure token lifecycle for that specific request.
model Download {
  id             String         @id @default(cuid())
  leadId         String
  bookId         String
  userId         String?
  tokenHash      String         @unique
  tokenExpiresAt DateTime
  status         DownloadStatus @default(PENDING)
  downloadedAt   DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  book           Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])
  emailLogs      EmailLog[]

  @@index([leadId])
  @@index([bookId])
  @@index([status])
  @@map("downloads")
}

/// One row per email SEND ATTEMPT for a download (supports resends), so
/// Admin > Email Logs can show full delivery history per download.
model EmailLog {
  id                String      @id @default(cuid())
  downloadId        String
  to                String
  subject           String
  provider          String      @default("resend")
  providerMessageId String?
  status            EmailStatus @default(QUEUED)
  error             String?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  download          Download    @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  @@index([downloadId])
  @@index([status])
  @@map("email_logs")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookFormat {
  EBOOK
  WHITEPAPER
  REPORT
  CASE_STUDY
  GUIDE
  DATASHEET
  WEBINAR
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_501_1000
  SIZE_1001_5000
  SIZE_5001_10000
  SIZE_10000_PLUS
}

enum DownloadStatus {
  PENDING
  EMAIL_SENT
  DOWNLOADED
  EXPIRED
  FAILED
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}


enum PublisherRequestStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

model PublisherRequest {
  id              String                 @id @default(cuid())
  fullName        String
  email           String
  jobTitle        String
  companyName     String
  bookTitle       String
  bookDescription String?
  pdfFileKey      String?
  status          PublisherRequestStatus @default(PENDING)
  adminNotes      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt


  


  @@index([status])
  @@index([createdAt])
}